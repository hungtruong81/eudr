{
    "name": "ngocquang/eudr-2025-api",
    "description": "APIs for eudr-2025-api",
    "keywords": [
      "microframework",
      "rest",
      "router",
      "psr7"
    ],
    "version": "1.0.0",
    "homepage": "https://github.com/ngocquang/eudr-2025-api",
    "private":"true",
    "authors": [
        {
            "name": "Quang Dinh",
            "email": "ngocquangbb@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "aws/aws-sdk-php": "^3.339",
        "endroid/qr-code": "^6.0",
        "firebase/php-jwt": "^6.3",
        "google/cloud-document-ai": "^2.2.2",
        "guzzlehttp/guzzle": "^7.5",
        "jbzoo/image": "^7.0.1",
        "league/oauth2-client": "^2.8",
        "microsoft/kiota-authentication-phpleague": "^1.5",
        "microsoft/microsoft-graph": "^2.26",
        "monolog/monolog": "^3.0",
        "openai-php/client": "^0.8.1",
        "php-di/php-di": "^6.4",
        "phpmailer/phpmailer": "^6.10",
        "phpoffice/phpspreadsheet": "^5.0",
        "phpoffice/phpword": "^1.2",
        "phpseclib/phpseclib": "^3.0",
        "psr/log": "^3.0",
        "slim/psr7": "^1.3",
        "slim/slim": "^4.14.0",
        "smalot/pdfparser": "^2.8",
        "stechstudio/backoff": "^1.4",
        "thingengineer/mysqli-database-class": "dev-master",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit"
    }
}
